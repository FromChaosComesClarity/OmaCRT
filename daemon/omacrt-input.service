[Unit]
Description=OmaCRT gamepad-to-keyboard input daemon
# Needs the graphical (Hyprland) session up: it talks to Hyprland's IPC
# socket to know when a fullscreen app has taken the controller over.
PartOf=graphical-session.target
After=graphical-session.target
# Safety net, not the primary fix -- the primary fix is the daemon itself
# waiting for a gamepad instead of exiting when one isn't connected (see
# omacrt_input.py). This just caps things if some *other* crash cause shows
# up later: stop retrying after 10 failures in 60s rather than indefinitely.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
# Assumes the standard clone location documented in the repo's README/SETUP.md.
# Update this path if the repo lives somewhere else on a given machine.
ExecStart=/usr/bin/python3 -u %h/Documents/DEVELOPMENT/CLAUDE/OmaCRT/daemon/omacrt_input.py --layout xbox
Restart=on-failure
RestartSec=2
# NOTE: SupplementaryGroups= does NOT work here -- it requires privileges a
# `--user` systemd instance doesn't have (setting supplementary groups is a
# system/PID1-only feature); declaring it makes the service fail outright
# (systemd exit 216/GROUP) rather than being harmlessly ignored. Learned by
# hitting it directly: this service instead relies on the graphical login
# session itself already having the `input` group (see docs/SETUP.md) --
# true for a normal fresh login, just not for an already-open session from
# before the group was added.

[Install]
WantedBy=graphical-session.target
